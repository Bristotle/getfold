# ---------------------------------------------------------------
# Supabase, Settings > API
# ---------------------------------------------------------------
# Both of these are NEXT_PUBLIC_ on purpose: they are safe to ship to
# the browser. The anon key grants no access on its own. Row-Level
# Security in supabase/migrations/0001_init.sql is the actual boundary.
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# ---------------------------------------------------------------
# Postgres, Settings > Database > Connection string
# ---------------------------------------------------------------
# Pooled, "Transaction mode" (port 6543). For app/runtime queries.
DATABASE_URL="postgresql://postgres.YOUR-PROJECT-REF:PASSWORD@aws-1-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection (port 5432). Prisma migrations run through this,
# the transaction pooler does not support them.
DIRECT_URL="postgresql://postgres.YOUR-PROJECT-REF:PASSWORD@aws-1-eu-west-1.pooler.supabase.com:5432/postgres"

# ---------------------------------------------------------------
# SMS (optional). No Ghana SMS provider exists on the Vercel
# Marketplace, so this is configured directly.
# ---------------------------------------------------------------
# Leave SMS_PROVIDER unset and messages are still recorded, with status
# "Not sent", so you can see exactly what would go out. Nothing is lost.
#
# SMS_PROVIDER="arkesel"          # arkesel | hubtel | twilio
# SMS_SENDER_ID="YourChurch"      # 11 chars max, must be pre-registered
# ARKESEL_API_KEY=""
# HUBTEL_CLIENT_ID=""
# HUBTEL_CLIENT_SECRET=""
# TWILIO_ACCOUNT_SID=""
# TWILIO_AUTH_TOKEN=""
# TWILIO_FROM_NUMBER=""

# ---------------------------------------------------------------
# Paystack, mobile money collection (MTN / Telecel / AirtelTigo).
# ---------------------------------------------------------------
# Test keys are free and instant from dashboard.paystack.com. You do not
# need a live church or a signed merchant agreement to build and test.
# Without a key the Giving page still works for cash; the mobile money
# card simply shows "Not connected".
# PAYSTACK_SECRET_KEY="sk_test_..."

# Required for the webhook ONLY. Paystack posts to /api/paystack/webhook
# with no user session, so it cannot satisfy RLS, so it needs the service
# role to write the confirmed contribution. Find it under
# Supabase > Settings > API Keys > service_role.
#
# NEVER expose this to the browser. It bypasses every RLS policy in the
# database, so it must not be prefixed NEXT_PUBLIC_ and must not be
# imported into a client component.
# SUPABASE_SERVICE_ROLE_KEY=""

# Point Paystack at:  https://<your-domain>/api/paystack/webhook
# (Dashboard > Settings > API Keys & Webhooks). Locally, tunnel with
# ngrok, a webhook cannot reach localhost.

# ---------------------------------------------------------------------------
# Photographs
#
# Only set these for an image you hold the right to publish commercially:
# your own, one taken for you, one licensed, or one you have written
# permission for. A photograph of identifiable people at a religious
# gathering also needs their consent, and religious belief is special
# personal data under Act 843.
# ---------------------------------------------------------------------------

# Path under /public, for example /congregation.jpg
NEXT_PUBLIC_CONGREGATION_IMAGE=
# The church's name. This is what turns the photograph into social proof.
NEXT_PUBLIC_CONGREGATION_CAPTION=
# Attribution, where the licence or the owner asks for it.
NEXT_PUBLIC_CONGREGATION_CREDIT=
# What is in the picture, for anyone using a screen reader.
NEXT_PUBLIC_CONGREGATION_ALT=

# The panel beside the login and sign up forms. Falls back to a CSS sky.
NEXT_PUBLIC_AUTH_IMAGE=

# ---------------------------------------------------------------------------
# Scheduled jobs
#
# The trial reminder runs daily at 09:00 UTC and uses the service role key,
# so the route refuses any request that does not present this secret. Set it
# to a long random string, and set the same value in Vercel. Without it the
# route returns 401 and sends nothing, which is the safe failure.
# ---------------------------------------------------------------------------
CRON_SECRET=

# ---------------------------------------------------------------------------
# WhatsApp support
#
# Country code, no plus, no spaces. For 024 790 2348 that is 233247902348.
#
# No NEXT_PUBLIC_ prefix on purpose. The site links to /whatsapp, a server
# route that redirects, so the number never appears in the HTML where a
# scraper could harvest it, and never in the client bundle either. Swap this
# for a business line and nothing else changes.
# ---------------------------------------------------------------------------
WHATSAPP_NUMBER=
